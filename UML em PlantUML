
@startuml
title Diagrama de Casos de Uso - ExploraART
left to right direction
skinparam packageStyle folder
skinparam actorStyle awesome

' ===== ATORES =====
actor "Convidado" as Convidado
actor "Registado" as Registado
actor "Subscrito" as Subscrito
actor "Administrador" as Admin
actor "Administrador\nde comunidade" as AdminComunidade
actor "Serviço de email\n<<externo>>" as Email
actor "SIBS\n<<externo, simulado>>" as SIBS

' ===== HERANÇA DE PAPÉIS (RBAC) =====
' Convidado = utilizador sem sessão iniciada (com ou sem conta)
Registado <|-- Subscrito
Subscrito <|-- Admin
Registado <|-- AdminComunidade

' ===== SISTEMA PRINCIPAL: os pacotes são representados como packages =====
rectangle "Sistema ExploraART" {
  package "Acesso e conta" as PK_ACE {
  }
  package "Perfil e definições" as PK_PER {
  }
  package "Conteúdo e interação" as PK_CON {
  }
  package "Subscrição e pagamentos" as PK_SUB {
  }
  package "Música" as PK_MUS {
  }
  package "Comunidades e mensagens" as PK_COM {
  }
  package "Moderação" as PK_MOD {
  }
}

' ===== PACOTES DETALHADOS COMO SISTEMAS INDIVIDUAIS (mesmo nome do pacote) =====

